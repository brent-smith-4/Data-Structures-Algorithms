import java.util.*;

public class SortedLinkedList {

    private NodeType head;
    private NodeType currentPos;

    public SortedLinkedList() {
	head = null;
	currentPos = null;
    } // constructor

    public int getLength() {
	NodeType temp = head;
	int count = 0;
	while (temp != null) {
	    temp = temp.next;
	    count++;
	} // while
	return count;
    } // method

    public void print() {
	currentPos = head;
	while (currentPos != null) {
	    System.out.print(currentPos.info.getValue() +  " ");
	    currentPos = currentPos.next;
	}  // while
	resetList();
	System.out.println();
    } // print

    public void insertItem(ItemType item) {
	NodeType newNode = new NodeType();
	newNode.next = null;
	newNode.info = item;
	currentPos = head;
	if (currentPos == null) {
	    resetList();
	    head = newNode;
	    return;
	} else if (item.compareTo(head.info) == -1) {
	    newNode.next = head;
	    head = newNode;
	    resetList();
	    return;
	} // if-else
	while (currentPos.next != null) {
	    int golNext = item.compareTo(currentPos.next.info);
	    int golCurrent = item.compareTo(currentPos.info);
	    if (golNext == -1 && golCurrent == 1) {
                newNode.next = currentPos.next;
                currentPos.next = newNode;
		resetList();
                return;
	    } else if (golCurrent == 0) {
		System.out.println("Item already exists");
		resetList();
		return;
	    } else {
		currentPos = currentPos.next;
	    } // if-else
	} // while
	if (item.compareTo(currentPos.info) == 0) {
	    System.out.println("Item already exists");
	    return;
	} // if
	currentPos.next = newNode;
	resetList();
	return;
    } // method

    public void mergeList(ItemType item) {
	NodeType newNode = new NodeType();
        newNode.next = null;
        newNode.info = item;
        currentPos = head;
        if (currentPos == null) {
            resetList();
            head = newNode;
            return;
        } else if (item.compareTo(head.info) == -1) {
            newNode.next = head;
            head = newNode;
            resetList();
            return;
        } // if-else
        while (currentPos.next != null) {
            int golNext = item.compareTo(currentPos.next.info);
            int golCurrent = item.compareTo(currentPos.info);
            if (golNext == -1 && golCurrent == 1) {
                newNode.next = currentPos.next;
                currentPos.next = newNode;
                resetList();
                return;
            } else if (golCurrent == 0) {
                resetList();
                return;
            } else {
                currentPos = currentPos.next;
            } // if-else
        } // while
        if (item.compareTo(currentPos.info) == 0) {
            return;
        } // if
        currentPos.next = newNode;
        resetList();
        return;
    } // method
    
    public void deleteItem(ItemType item) {
        if (head == null) {
            System.out.println("You cannot delete from an empty list");
	    return;
	} // if
        currentPos = head;
	NodeType prev = null;
        while (currentPos != null) {
            int gol = item.compareTo(currentPos.info);
            if (gol == 0) {
		if (prev == null) {
		    head = currentPos.next;
		    resetList();
		    return;
		}
		prev.next = currentPos.next;
                currentPos = null;
		return;
            } else {
		prev = currentPos;
                currentPos = currentPos.next;
            } // if-else
        } // while
	System.out.println("The item is not present in the list");
    }  // method

    public void deleteAltNode() {
	boolean even = false;
	NodeType prev = null;
	NodeType temp = head;
	while (temp != null) {
	    currentPos = temp;
	    if (even) {
	       prev.next = currentPos.next;
               currentPos = null;
	       even = false;
	       temp = temp.next;
	    } else {
		prev = currentPos;
		currentPos = currentPos.next;
		even = true;
		temp = temp.next;
	    } // if-else
	} // while
	resetList();
    } // method
	
    public int searchItem(ItemType item) {
	if (head == null)
	    return -1; // int to designate empty list
	int index = 1;
	currentPos = head;
	while (currentPos != null) {
	    NodeType temp = currentPos;
	    int gol = item.compareTo(temp.info);
            if (gol == 0) {
		resetList();
                return index;
            } else {
                currentPos = currentPos.next;
                index++;
            } // if-else
	} // while
	resetList();
	return -2; // item couldnt be found
    } // method

    public boolean findIntersection (ItemType item) {
	if (head == null)
            return false;
        currentPos = head;
        while (currentPos != null) {
            NodeType temp = currentPos;
            int gol = item.compareTo(temp.info);
            if (gol == 0) {
                resetList();
                return true;
            } else {
                currentPos = currentPos.next;
            } // if-else
        } // while
        resetList();
        return false; // item couldnt be found

    } // findIntersection
    
    public ItemType getNextItem() {
	ItemType nextItem = new ItemType();
	if (head == null) {
	    return null;
        } else if (currentPos == null) {
	    currentPos = head.next;
	    return head.info;
        } else {
	    nextItem = currentPos.info;
	    currentPos = currentPos.next;
	    return nextItem;
	}  // if-else
    } //  method

    public void resetList() {
	currentPos = null;
    } // method
} // class
